+  /**
+   * The stale-wins verdict as snapshot-summary properties, merged into the rewrite commit by the action.
+   * Empty when the audit is off. (M2: inline key list; Puffin spill for large lists is a follow-up.)
+   */
+  Map<String, String> auditSnapshotSummary() {
+    if (!auditStaleWins) {
+      return Collections.emptyMap();
+    }
+    List<String> keys;
+    synchronized (auditStaleWinsKeyJson) {
+      keys = Lists.newArrayList(auditStaleWinsKeyJson);
+    }
+    Map<String, String> props = new HashMap<>();
+    props.put(SUMMARY_ORDERING, orderingColumn);
+    props.put(SUMMARY_KEY_COLUMNS, String.join(",", keyColumns));
+    props.put(SUMMARY_GROUPS_TOTAL, String.valueOf(groupsTotal.get()));
+    props.put(SUMMARY_GROUPS_GATED, String.valueOf(groupsGated.get()));
+    props.put(SUMMARY_GROUPS_AUDITED, String.valueOf(groupsAudited.get()));
+    props.put(SUMMARY_CROSS_GROUP, String.valueOf(auditCrossGroup));
+
+    // FAIL CLOSED. The single-survivor guard is evaluated WITHIN a group, so it is sound only while
+    // every surviving version of a key is co-resident there. Once the rewrite forms more than one
+    // group that precondition is not established, and a per-group verdict can contain keys that are
+    // not violations -- measured, not hypothetical. Publishing it anyway would trade the mechanism's
+    // one-sidedness for recall it does not even have in that regime. So we abstain: no key list, no
+    // count, an explicit undecidable in its place. Cross-group mode makes the survivor count global
+    // and is the way to get a verdict here.
+    if (!auditCrossGroup && groupsTotal.get() > 1) {
+      props.put(SUMMARY_VERDICT, "undecidable");
+      props.put(
+          SUMMARY_UNDECIDABLE_REASON,
+          "key versions may straddle "
+              + groupsTotal.get()
+              + " file groups; per-group detection cannot establish a global survivor count. "
+              + "Re-run with "
+              + AUDIT_CROSS_GROUP
+              + "=true for a decidable verdict.");
+      this.pendingSpillJson = null;
+      return props;
+    }
+
+    props.put(SUMMARY_VERDICT, "decided");
+    props.put(SUMMARY_COUNT, String.valueOf(keys.size()));
+    String keysJson = "[" + String.join(",", keys) + "]";
+    if (keysJson.length() > spillThresholdBytes) {
+      // Spill: the list goes to a Puffin blob registered as a statistics file (see the action). It is
+      // deliberately NOT referenced by a path string in this summary -- a path in a property is not in
+      // the set `remove_orphan_files` treats as reachable, so such a sidecar is deleted by routine
+      // maintenance. Registration is what makes it format-reachable.
+      this.pendingSpillJson = keysJson;
+      props.put(SUMMARY_KEYS_SPILLED, "true");
+    } else {
+      props.put(SUMMARY_KEYS, keysJson);
+      props.put(SUMMARY_KEYS_SPILLED, "false");
+    }
+    if (auditCrossGroup) {
+      // The complete (cross-group) verdict. The per-group list above stays as written, so both the
+      // base result and the merged result are visible in the same snapshot.
+      List<String> merged = crossGroupStaleWins();
+      props.put(SUMMARY_CROSS_GROUP_KEYS, "[" + String.join(",", merged) + "]");
+      props.put(SUMMARY_COUNT, String.valueOf(merged.size()));
+      props.put(SUMMARY_STRADDLE_CANDIDATES, String.valueOf(crossMaxDiscarded.size()));
+    }
+    return props;
+  }

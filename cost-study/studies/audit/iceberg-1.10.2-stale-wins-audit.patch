+  /**
+   * Merge one group's per-key partials into the table-level accumulators. Rows are
+   * (key..., D_MAX, S_MAX, S_CNT): the max ordering among versions this group discarded, the ordering of
+   * the survivor if this group holds it, and the local survivor count. A key's versions may be spread
+   * over several groups, so each group contributes what it saw and the comparison happens at commit.
+   */
+  private void collectCrossGroup(Dataset<Row> perKey) {
+    int nk = keyColumns.size();
+    for (Row row : perKey.collectAsList()) {
+      StringBuilder k = new StringBuilder("[");
+      for (int c = 0; c < nk; c++) {
+        k.append(c == 0 ? "" : ",").append(jsonValue(row.get(c)));
+      }
+      k.append("]");
+      String key = k.toString();
+      crossKeyJson.putIfAbsent(key, key);
+
+      Object dmax = row.get(nk);
+      Object smax = row.get(nk + 1);
+      long scnt = row.getLong(nk + 2);
+      if (dmax != null) {
+        crossMaxDiscarded.merge(key, asComparable(dmax), SparkBinPackFileRewriteRunner::maxOf);
+      }
+      if (scnt > 0) {
+        crossSurvivorCount.merge(key, scnt, Long::sum);
+        if (smax != null) {
+          crossSurvivor.merge(key, asComparable(smax), SparkBinPackFileRewriteRunner::maxOf);
+        }
+      }
+    }
+  }
+
+  @SuppressWarnings("unchecked")
+  private static Comparable<Object> asComparable(Object v) {
+    return (Comparable<Object>) v;
+  }
+
+  private static Comparable<Object> maxOf(Comparable<Object> a, Comparable<Object> b) {
+    return a.compareTo(b) >= 0 ? a : b;
+  }
+
+  /**
+   * Table-level resolution: a key is a cross-group stale-win iff it has exactly one surviving version
+   * table-wide and the maximum ordering value among versions discarded in ANY group exceeds it. Keys
+   * already flagged within a single group are included by the same test, so this is a superset of the
+   * base verdict.
+   */
+  private List<String> crossGroupStaleWins() {
+    List<String> out = Lists.newArrayList();
+    for (Map.Entry<String, Comparable<Object>> e : crossMaxDiscarded.entrySet()) {
+      String key = e.getKey();
+      Comparable<Object> survivor = crossSurvivor.get(key);
+      Long scnt = crossSurvivorCount.get(key);
+      if (survivor == null || scnt == null || scnt != 1L) {
+        continue; // no surviving version (deleted), or a duplicate: not the stale-wins class
+      }
+      if (e.getValue().compareTo((Object) survivor) > 0) {
+        out.add(key);
+      }
+    }
+    return out;
+  }

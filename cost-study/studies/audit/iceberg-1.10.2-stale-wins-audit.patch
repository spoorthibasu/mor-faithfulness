+  private static String jsonValue(Object v) {
+    if (v == null) {
+      return "null";
+    }
+    if (v instanceof Number || v instanceof Boolean) {
+      return v.toString();
+    }
+    return "\"" + v.toString().replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
+  }
+
+  /**
+   * Metadata-only necessary condition for a within-group stale-win: sorted by data sequence number, some
+   * data file's ordering upper bound exceeds a later file's ordering lower bound (an inversion). If no
+   * inversion exists, ordering is monotone with sequence at file granularity and no key can have a
+   * discarded version out-ordering its survivor here. Sound (a real stale-win implies an inversion),
+   * conservative (an inversion across different keys triggers an audit that finds nothing). Missing
+   * bounds ⇒ audit.
+   */
+  private boolean mayContainStaleWins(RewriteFileGroup group) {
+    Type.PrimitiveType type =
+        table().schema().findField(orderingColumn).type().asPrimitiveType();
+    Comparator<Object> cmp = Comparators.forType(type);
+    Map<String, ByteBuffer[]> bounds = orderingBoundsByPath();
+
+    List<Object[]> files = Lists.newArrayList(); // {dataSeq (Long), ordMin, ordMax}
+    for (FileScanTask task : group.fileScanTasks()) {
+      DataFile file = task.file();
+      Long seq = file.dataSequenceNumber();
+      ByteBuffer[] b = bounds.get(file.location());
+      if (seq == null || b == null) {
+        return true; // cannot rule out a stale-win without seq + ordering bounds
+      }
+      files.add(
+          new Object[] {seq, Conversions.fromByteBuffer(type, b[0]), Conversions.fromByteBuffer(type, b[1])});
+    }
+
+    files.sort(Comparator.comparingLong(f -> (Long) f[0]));
+    Object runningMaxOrd = null;
+    for (Object[] f : files) {
+      Object ordMin = f[1];
+      Object ordMax = f[2];
+      if (runningMaxOrd != null && cmp.compare(ordMin, runningMaxOrd) < 0) {
+        return true; // an earlier-sequence file out-orders this later file's minimum
+      }
+      if (runningMaxOrd == null || cmp.compare(ordMax, runningMaxOrd) > 0) {
+        runningMaxOrd = ordMax;
+      }
+    }
+    return false;
+  }
+
+  /**
+   * Ordering-column [lower, upper] per data-file path, read once from the current snapshot's manifests
+   * (the rewrite scan task drops column stats, so the gate cannot read them off the task's DataFile).
+   * Files whose ordering bounds are absent are simply not in the map, and the gate audits them.
+   */
+  private Map<String, ByteBuffer[]> orderingBoundsByPath() {
+    if (orderingBoundsByPath == null) {
+      synchronized (this) {
+        if (orderingBoundsByPath == null) {
+          int fieldId = table().schema().findField(orderingColumn).fieldId();
+          Map<String, ByteBuffer[]> map = Maps.newHashMap();
+          Snapshot snapshot = table().currentSnapshot();
+          if (snapshot != null) {
+            for (ManifestFile manifest : snapshot.dataManifests(table().io())) {
+              try (ManifestReader<DataFile> reader =
+                  ManifestFiles.read(manifest, table().io(), table().specs())) {
+                for (DataFile file : reader) {
+                  Map<Integer, ByteBuffer> lower = file.lowerBounds();
+                  Map<Integer, ByteBuffer> upper = file.upperBounds();
+                  ByteBuffer lo = lower == null ? null : lower.get(fieldId);
+                  ByteBuffer hi = upper == null ? null : upper.get(fieldId);
+                  if (lo != null && hi != null) {
+                    map.put(file.location(), new ByteBuffer[] {lo, hi});
+                  }
+                }
+              } catch (IOException e) {
+                throw new UncheckedIOException("failed reading manifest for audit gate", e);
+              }
+            }
+          }
+          orderingBoundsByPath = map;
+        }
+      }
+    }
+    return orderingBoundsByPath;
+  }
